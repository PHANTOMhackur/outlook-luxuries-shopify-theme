<section class="page-width section-space"><div class="section-heading"><div><p class="eyebrow">WHAT PEOPLE SAY</p><h2>{{ section.settings.heading }}</h2></div></div><div class="testimonial-grid">{% for block in section.blocks %}<article class="testimonial" {{ block.shopify_attributes }}><div class="stars">★★★★★</div><blockquote>“{{ block.settings.quote }}”</blockquote><p>{{ block.settings.name }}</p></article>{% endfor %}</div></section>
{% schema %}
{"name":"Testimonials","settings":[{"type":"text","id":"heading","label":"Heading","default":"Loved by fragrance lovers"}],"blocks":[{"type":"quote","name":"Quote","settings":[{"type":"textarea","id":"quote","label":"Quote","default":"The packaging, selection and delivery were excellent."},{"type":"text","id":"name","label":"Name","default":"Verified customer"}]}],"presets":[{"name":"Testimonials","blocks":[{"type":"quote"},{"type":"quote"},{"type":"quote"}]}]}
{% endschema %}
