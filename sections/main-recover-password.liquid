<section class="page-width section-space auth-page"><div class="auth-card"><p class="eyebrow">ACCOUNT</p><h1>Reset password</h1><p>We’ll email you a link to choose a new password.</p>{% form 'recover_customer_password' %}<label>Email<input name="email" type="email" required></label><button class="button button--dark button--full">Send reset link</button>{% if form.posted_successfully? %}<p class="form-success">Check your inbox for the reset link.</p>{% endif %}{{ form.errors | default_errors }}{% endform %}<a class="text-link" href="{{ routes.account_login_url }}">Back to sign in</a></div></section>
{% schema %}{"name":"Recover password"}{% endschema %}
