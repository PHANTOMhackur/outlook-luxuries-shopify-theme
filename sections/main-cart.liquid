<section class="page-width section-space olx-cart">
  <div class="breadcrumbs"><a href="{{ routes.root_url }}">Home</a><span>/</span><span>Cart</span></div>
  <div class="collection-head"><div><p class="eyebrow">YOUR BAG</p><h1>Shopping cart</h1></div><div class="collection-count">{{ cart.item_count }} items</div></div>
  {% if cart.item_count == 0 %}<div class="empty-state"><h2>Your cart is empty.</h2><p>Discover perfumes and attars to start your fragrance wardrobe.</p><div class="button-row"><a class="button button--dark" href="/pages/perfumes">Shop perfumes</a><a class="button button--outline" href="/pages/attars">Shop attars</a></div></div>
  {% else %}<form class="olx-cart-form" action="{{ routes.cart_url }}" method="post"><div>{% for item in cart.items %}<div class="olx-cart-line"><a class="olx-cart-line__media" href="{{ item.url }}">{{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', widths: '150,220,300', sizes: '140px', alt: item.product.title | escape }}</a><div><p class="product-card__vendor">{{ item.product.vendor }}</p><h3><a href="{{ item.url }}">{{ item.product.title }}</a></h3>{% unless item.product.has_only_default_variant %}<p class="product-card__meta">{{ item.variant.title }}</p>{% endunless %}<div class="olx-cart-line__bottom"><div class="quantity"><button type="button" data-cart-minus="{{ forloop.index }}">−</button><input name="updates[]" type="number" min="0" value="{{ item.quantity }}"><button type="button" data-cart-plus="{{ forloop.index }}">+</button></div><strong>{{ item.final_line_price | money }}</strong></div><a class="text-link" href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0">Remove</a></div></div>{% endfor %}</div><aside class="olx-summary"><h2>Summary</h2><div><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></div><p>Taxes and shipping are calculated at checkout.</p><button class="button button--outline button--full" name="update" type="submit">Update cart</button><button class="button button--dark button--full" name="checkout" type="submit">Checkout</button></aside></form>{% endif %}
</section>
{% schema %}{"name":"Cart"}{% endschema %}
