<section class="page-width section-space olx-contact"><div class="olx-contact-grid"><div><p class="eyebrow">CONTACT</p><h1>{{ section.settings.heading }}</h1><div class="rte">{{ section.settings.text }}</div><div class="contact-details"><div><strong>Email</strong><span>{{ section.settings.email }}</span></div><div><strong>Hours</strong><span>{{ section.settings.hours }}</span></div></div></div>{% form 'contact', class: 'contact-form' %}<label>Name<input type="text" name="contact[name]" required></label><label>Email<input type="email" name="contact[email]" required></label><label>Phone<input type="tel" name="contact[phone]"></label><label>Message<textarea name="contact[body]" rows="7" required></textarea></label><button type="submit" class="button button--dark">Send message</button>{% if form.posted_successfully? %}<p class="form-success">Message sent successfully.</p>{% endif %}{{ form.errors | default_errors }}{% endform %}</div></section>
{% schema %}{"name":"Contact","settings":[{"type":"text","id":"heading","label":"Heading","default":"Let’s talk fragrance."},{"type":"richtext","id":"text","label":"Text","default":"<p>Questions about products, orders, gifting or a fragrance house? We’re here to help.</p>"},{"type":"text","id":"email","label":"Email","default":"hello@outlookluxuries.com"},{"type":"text","id":"hours","label":"Hours","default":"Mon–Sat, 10:00–18:00"}]}{% endschema %}
