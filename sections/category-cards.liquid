<section class="page-width section-space">
  <div class="section-heading"><div><p class="eyebrow">SHOP YOUR WAY</p><h2>{{ section.settings.heading }}</h2></div></div>
  <div class="category-grid">
    {% for block in section.blocks %}
      <a class="category-card" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400,700,1000,1200', sizes: '(min-width: 990px) 50vw, 100vw' }}
        {% else %}<div class="media-placeholder"></div>{% endif %}
        <div class="category-card__content"><span>{{ block.settings.kicker }}</span><h3>{{ block.settings.title }}</h3><b>{{ block.settings.cta }} →</b></div>
      </a>
    {% endfor %}
  </div>
</section>
{% schema %}
{"name":"Category cards","settings":[{"type":"text","id":"heading","label":"Heading","default":"Discover fragrance"}],"blocks":[{"type":"category","name":"Category","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"kicker","label":"Kicker","default":"01"},{"type":"text","id":"title","label":"Title","default":"Perfumes"},{"type":"text","id":"cta","label":"CTA","default":"Explore"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"Category cards","blocks":[{"type":"category","settings":{"kicker":"01","title":"Perfumes","cta":"Explore Perfumes"}},{"type":"category","settings":{"kicker":"02","title":"Attars","cta":"Explore Attars"}}]}]}
{% endschema %}
