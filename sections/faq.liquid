<section class="page-width section-space olx-faq"><div class="section-heading"><div><p class="eyebrow">HELP</p><h2>{{ section.settings.heading }}</h2></div></div><div class="faq-list">{% for block in section.blocks %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.question }}<span>+</span></summary><div class="rte">{{ block.settings.answer }}</div></details>{% endfor %}</div></section>
{% schema %}{"name":"FAQ","settings":[{"type":"text","id":"heading","label":"Heading","default":"Frequently asked questions"}],"blocks":[{"type":"faq","name":"Question","settings":[{"type":"text","id":"question","label":"Question","default":"How do I choose a perfume?"},{"type":"richtext","id":"answer","label":"Answer","default":"<p>Start with the fragrance family or notes you enjoy, then explore a brand collection and product details.</p>"}]}],"max_blocks":20,"presets":[{"name":"FAQ","blocks":[{"type":"faq"},{"type":"faq"},{"type":"faq"}]}]}{% endschema %}
