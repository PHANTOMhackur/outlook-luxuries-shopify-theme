<footer class="site-footer"><div class="page-width footer-grid"><div><a class="brand-mark brand-mark--footer" href="{{ routes.root_url }}">{{ section.settings.logo_text }}</a><p>{{ section.settings.description }}</p></div><div><h3>Shop</h3><a href="{{ section.settings.perfume_url | default: '/pages/perfumes' }}">Perfumes</a><a href="{{ section.settings.attar_url | default: '/pages/attars' }}">Attars</a><a href="{{ section.settings.brands_url | default: '/pages/brands' }}">Brands</a><a href="{{ routes.all_products_collection_url }}">Shop All</a></div><div><h3>Help</h3><a href="/pages/contact">Contact</a><a href="/pages/shipping">Shipping</a><a href="/pages/returns">Returns</a><a href="/pages/faq">FAQ</a></div><div><h3>Follow</h3><a href="{{ section.settings.instagram }}">Instagram</a><a href="{{ section.settings.facebook }}">Facebook</a><a href="{{ section.settings.youtube }}">YouTube</a></div></div><div class="footer-bottom page-width"><span>© {{ 'now' | date: '%Y' }} {{ shop.name }}</span><span>All rights reserved.</span></div></footer>
{% schema %}
{"name":"Footer","settings":[{"type":"text","id":"logo_text","label":"Logo text","default":"OUTLOOK LUXURIES"},{"type":"textarea","id":"description","label":"Description","default":"Premium perfumes and attars, thoughtfully curated from fragrance houses around the world."},{"type":"url","id":"perfume_url","label":"Perfume link"},{"type":"url","id":"attar_url","label":"Attar link"},{"type":"url","id":"brands_url","label":"Brands link"},{"type":"url","id":"instagram","label":"Instagram"},{"type":"url","id":"facebook","label":"Facebook"},{"type":"url","id":"youtube","label":"YouTube"}]}
{% endschema %}
