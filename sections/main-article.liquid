<section class="page-width section-space olx-article"><div class="article-header"><small>{{ article.published_at | date: '%d %B %Y' }} · {{ article.author }}</small><h1>{{ article.title }}</h1>{% if article.image %}{{ article.image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '800,1200,1600', sizes: '100vw', alt: article.image.alt | escape }}{% endif %}</div><div class="rte olx-article__body">{{ article.content }}</div><div class="article-footer"><a class="text-link" href="{{ blog.url }}">← Back to journal</a></div></section>
{% schema %}{"name":"Article"}{% endschema %}
