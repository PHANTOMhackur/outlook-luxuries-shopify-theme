<section class="page-width section-space auth-page"><div class="auth-card"><p class="eyebrow">ACCOUNT</p><h1>Create account</h1>{% form 'create_customer' %}<div class="form-row"><label>First name<input name="customer[first_name]" required></label><label>Last name<input name="customer[last_name]" required></label></div><label>Email<input name="customer[email]" type="email" required></label><label>Password<input name="customer[password]" type="password" required></label><button class="button button--dark button--full">Create account</button>{{ form.errors | default_errors }}{% endform %}<p>Already have an account? <a class="text-link" href="{{ routes.account_login_url }}">Sign in</a></p></div></section>
{% schema %}{"name":"Register"}{% endschema %}
