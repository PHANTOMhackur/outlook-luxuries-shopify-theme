<aside class="cart-drawer" data-cart-drawer aria-hidden="true"><div class="cart-drawer__scrim" data-cart-close></div><div class="cart-drawer__panel"><div class="cart-drawer__head"><h2>Cart <span data-cart-drawer-count>{{ cart.item_count }}</span></h2><button class="icon-button" type="button" data-cart-close aria-label="Close cart">×</button></div><div class="cart-drawer__body" data-cart-body>{% if cart.item_count == 0 %}<div class="drawer-empty"><h3>Your cart is empty</h3><p>Explore perfumes and attars to begin.</p><a href="/pages/perfumes" class="button button--dark">Shop perfumes</a></div>{% else %}{% for item in cart.items %}<div class="drawer-line"><a href="{{ item.url }}" class="drawer-line__image">{{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', widths: '100,150,200', sizes: '78px', alt: item.product.title | escape }}</a><div><a class="drawer-line__title" href="{{ item.url }}">{{ item.product.title }}</a>{% unless item.product.has_only_default_variant %}<small>{{ item.variant.title }}</small>{% endunless %}<div class="drawer-line__bottom"><span>{{ item.final_line_price | money }}</span><div class="drawer-line__controls"><button type="button" aria-label="Decrease quantity" data-drawer-line-minus data-drawer-line="{{ forloop.index }}">−</button><span>{{ item.quantity }}</span><button type="button" aria-label="Increase quantity" data-drawer-line-plus data-drawer-line="{{ forloop.index }}">+</button><button type="button" class="drawer-line__remove" data-drawer-line-remove data-drawer-line="{{ forloop.index }}">Remove</button></div></div></div></div>{% endfor %}{% endif %}</div>{% if cart.item_count > 0 %}<div class="cart-drawer__foot"><div class="drawer-subtotal"><span>Subtotal</span><strong data-cart-subtotal>{{ cart.total_price | money }}</strong></div><a class="button button--outline button--full" href="{{ routes.cart_url }}">View cart</a><form action="{{ routes.cart_url }}" method="post"><button class="button button--dark button--full" name="checkout">Checkout</button></form></div>{% endif %}</div></aside>
{% schema %}{"name":"Cart drawer"}{% endschema %}
