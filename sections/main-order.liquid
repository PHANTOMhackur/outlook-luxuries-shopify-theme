<section class="page-width section-space account-page"><div class="page-heading__inner"><div><p class="eyebrow">ORDER {{ order.name }}</p><h1>{{ order.created_at | date: '%d %B %Y' }}</h1><p>{{ order.financial_status_label }} · {{ order.fulfillment_status_label }}</p></div><a class="text-link" href="{{ routes.account_url }}">← Account</a></div><div class="account-grid"><div class="account-panel"><div class="account-panel__head"><h2>Items</h2><b>{{ order.total_price | money }}</b></div>{% for line in order.line_items %}<div class="order-item"><div><strong>{{ line.title }}</strong>{% if line.variant.title != 'Default Title' %}<small>{{ line.variant.title }}</small>{% endif %}</div><span>{{ line.quantity }} × {{ line.final_price | money }}</span></div>{% endfor %}</div><div class="account-panel"><h2>Shipping</h2><p>{{ order.shipping_address | format_address }}</p></div></div></section>
{% schema %}{"name":"Customer order"}{% endschema %}
