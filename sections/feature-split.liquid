<section class="page-width section-space"><div class="feature-split {% if section.settings.reverse %}feature-split--reverse{% endif %}">
  <div class="feature-split__media">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600,900,1200,1400' }}{% else %}<div class="feature-placeholder"></div>{% endif %}</div>
  <div class="feature-split__content"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><div class="rte">{{ section.settings.text }}</div>{% if section.settings.link != blank %}<a class="button button--dark" href="{{ section.settings.link }}">{{ section.settings.label }}</a>{% endif %}</div>
</div></section>
{% schema %}
{"name":"Feature split","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"WHY SHOP WITH US"},{"type":"text","id":"heading","label":"Heading","default":"A better way to discover fragrance."},{"type":"richtext","id":"text","label":"Text","default":"<p>Curated brands, transparent product details and a premium shopping experience built for fragrance lovers.</p>"},{"type":"text","id":"label","label":"Button label","default":"Learn more"},{"type":"url","id":"link","label":"Button link"},{"type":"checkbox","id":"reverse","label":"Reverse layout","default":false}],"presets":[{"name":"Feature split"}]}
{% endschema %}
