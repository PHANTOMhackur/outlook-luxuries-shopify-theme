<section class="hero section-space">
  {% if section.settings.image != blank %}
    <div class="hero__media">
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', widths: '800,1200,1600,2000,2400', sizes: '100vw', class: 'hero__image' }}
    </div>
  {% else %}
    <div class="hero__media hero__placeholder"></div>
  {% endif %}
  <div class="hero__overlay"></div>
  <div class="page-width hero__content">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h1>{{ section.settings.heading }}</h1>
    <p class="hero__subtext">{{ section.settings.subtext }}</p>
    <div class="button-row">
      {% if section.settings.primary_link != blank %}<a class="button button--light" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a>{% endif %}
      {% if section.settings.secondary_link != blank %}<a class="button button--ghost" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>{% endif %}
    </div>
  </div>
</section>
{% schema %}
{
  "name":"Hero banner",
  "settings":[
    {"type":"image_picker","id":"image","label":"Desktop/mobile hero image"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE ART OF FRAGRANCE"},
    {"type":"text","id":"heading","label":"Heading","default":"Find a fragrance that feels like you."},
    {"type":"textarea","id":"subtext","label":"Subtext","default":"Curated perfumes and traditional attars from sought-after fragrance houses."},
    {"type":"url","id":"primary_link","label":"Primary link"},
    {"type":"text","id":"primary_label","label":"Primary label","default":"Shop Perfumes"},
    {"type":"url","id":"secondary_link","label":"Secondary link"},
    {"type":"text","id":"secondary_label","label":"Secondary label","default":"Explore Attars"}
  ],
  "presets":[{"name":"Hero banner"}]
}
{% endschema %}
