<section class="page-width section-space account-page"><div class="page-heading__inner"><div><p class="eyebrow">ACCOUNT</p><h1>Addresses</h1></div><a class="text-link" href="{{ routes.account_url }}">← Account</a></div><div class="address-grid">{% for address in customer.addresses %}<div class="account-panel"><div class="account-panel__head"><strong>{% if address == customer.default_address %}Default address{% else %}Address {{ forloop.index }}{% endif %}</strong></div>{{ address | format_address }}</div>{% endfor %}</div></section>
{% schema %}{"name":"Addresses"}{% endschema %}
