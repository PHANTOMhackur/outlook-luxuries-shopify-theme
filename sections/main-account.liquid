<section class="page-width section-space account-page"><div class="page-heading__inner"><div><p class="eyebrow">ACCOUNT</p><h1>Hello, {{ customer.first_name | default: customer.name }}</h1></div><a class="button button--outline" href="{{ routes.account_logout_url }}">Log out</a></div><div class="account-grid"><div class="account-panel"><div class="account-panel__head"><h2>Order history</h2></div>{% if customer.orders_count > 0 %}<div class="order-list">{% for order in customer.orders %}<a class="order-row" href="{{ order.customer_url }}"><strong>{{ order.name }}</strong><span>{{ order.created_at | date: '%d %b %Y' }}</span><span>{{ order.financial_status_label }}</span><b>{{ order.total_price | money }}</b></a>{% endfor %}</div>{% else %}<div class="empty-state"><h3>No orders yet</h3><a class="button button--dark" href="/pages/perfumes">Start shopping</a></div>{% endif %}</div><div class="account-panel"><div class="account-panel__head"><h2>Details</h2><a class="text-link" href="{{ routes.account_addresses_url }}">Addresses</a></div><p>{{ customer.email }}</p>{% if customer.default_address %}<p>{{ customer.default_address | format_address }}</p>{% endif %}</div></div></section>
{% schema %}{"name":"Account"}{% endschema %}
