<section class="page-width section-space auth-page"><div class="auth-card"><p class="eyebrow">ACCOUNT</p><h1>Welcome back</h1><p>Sign in to manage your orders and account details.</p>{% form 'customer_login' %}<label>Email<input name="customer[email]" type="email" required></label><label>Password<input name="customer[password]" type="password" required></label><button class="button button--dark button--full">Sign in</button>{{ form.errors | default_errors }}{% endform %}<a class="text-link" href="{{ routes.account_recover_url }}">Forgot password?</a><div class="auth-divider">New here?</div><a class="button button--outline button--full" href="{{ routes.account_register_url }}">Create account</a></div></section>
{% schema %}{"name":"Login"}{% endschema %}
