<section class="page-width section-space">
  <div class="section-heading"><div><p class="eyebrow">CURATED HOUSES</p><h2>{{ section.settings.heading }}</h2></div>{% if section.settings.link != blank %}<a class="text-link" href="{{ section.settings.link }}">View all brands →</a>{% endif %}</div>
  <div class="brand-grid">
    {% for block in section.blocks %}
      <a class="brand-card" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
        <div class="brand-card__image">
          {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '300,600,900' }}{% else %}<span>{{ block.settings.title | slice: 0, 1 }}</span>{% endif %}
        </div>
        <div class="brand-card__body"><h3>{{ block.settings.title }}</h3><p>{{ block.settings.caption }}</p></div>
      </a>
    {% endfor %}
  </div>
</section>
{% schema %}
{"name":"Brand grid","settings":[{"type":"text","id":"heading","label":"Heading","default":"Shop by brand"},{"type":"url","id":"link","label":"View all link"}],"blocks":[{"type":"brand","name":"Brand","settings":[{"type":"image_picker","id":"image","label":"Brand image/logo"},{"type":"text","id":"title","label":"Brand name","default":"Brand name"},{"type":"text","id":"caption","label":"Caption","default":"Explore the collection"},{"type":"url","id":"link","label":"Brand collection link"}]}],"presets":[{"name":"Brand grid","blocks":[{"type":"brand","settings":{"title":"Brand 01"}},{"type":"brand","settings":{"title":"Brand 02"}},{"type":"brand","settings":{"title":"Brand 03"}},{"type":"brand","settings":{"title":"Brand 04"}}]}]}
{% endschema %}
