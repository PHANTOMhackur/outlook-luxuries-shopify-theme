<section class="page-width section-space olx-blog"><div class="collection-head"><div><p class="eyebrow">JOURNAL</p><h1>{{ blog.title }}</h1>{% if blog.description != blank %}<div class="rte">{{ blog.description }}</div>{% endif %}</div></div>{% paginate blog.articles by 9 %}<div class="article-grid">{% for article in blog.articles %}<a class="article-card" href="{{ article.url }}"><div class="article-card__media">{% if article.image %}{{ article.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400,700,1000', sizes: '(min-width: 990px) 33vw, 100vw', alt: article.image.alt | escape }}{% else %}<div class="media-placeholder"></div>{% endif %}</div><div class="article-card__body"><small>{{ article.published_at | date: '%d %b %Y' }}</small><h2>{{ article.title }}</h2><p>{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p></div></a>{% endfor %}</div>{% if paginate.pages > 1 %}<nav class="pagination">{% if paginate.previous %}<a href="{{ paginate.previous.url }}">←</a>{% endif %}{% for part in paginate.parts %}{% if part.is_link %}<a href="{{ part.url }}">{{ part.title }}</a>{% else %}<span class="is-current">{{ part.title }}</span>{% endif %}{% endfor %}{% if paginate.next %}<a href="{{ paginate.next.url }}">→</a>{% endif %}</nav>{% endif %}{% endpaginate %}</section>
{% schema %}{"name":"Blog"}{% endschema %}
