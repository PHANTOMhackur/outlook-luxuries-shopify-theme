<article class="product-card">
  <a class="product-card__media" href="{{ product.url }}">
    {% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '360,540,720,900,1000', sizes: '(min-width: 1200px) 25vw, (min-width: 750px) 33vw, 50vw' }}{% else %}<div class="media-placeholder"></div>{% endif %}
    {% if product.compare_at_price > product.price %}<span class="badge">Sale</span>{% endif %}
  </a>
  <div class="product-card__body">
    {% if product.vendor != blank %}<p class="product-card__vendor">{{ product.vendor }}</p>{% endif %}
    <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
    {% if product.metafields.custom.fragrance_family != blank %}<p class="product-card__meta">{{ product.metafields.custom.fragrance_family }}</p>{% endif %}
    <div class="product-card__price">{{ product.price | money }}{% if product.compare_at_price > product.price %}<del>{{ product.compare_at_price | money }}</del>{% endif %}</div>
    {% if product.available %}
      <form method="post" action="{{ routes.cart_add_url }}" class="quick-add-form">
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <button class="button button--dark button--full" type="submit">Add to bag</button>
      </form>
    {% else %}<span class="sold-out">Sold out</span>{% endif %}
  </div>
</article>
